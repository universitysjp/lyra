{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://lyra-identity",
    "Audience": "lyra-api",
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "PlaylistRag": {
    "PrefetchCount": 3,
    "ConcurrentMessageLimit": 3,
    "RetryCount": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Rag": {
    "Provider": "OpenCode",
    "Model": "text-embedding-3-small",
    "Dimensions": 1536,
    "OpenCodePlan": "Go",
    "MaxInputCharacters": 8000,
    "RequestTimeoutSeconds": 60
  }
}
