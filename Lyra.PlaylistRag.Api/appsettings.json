{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://lyra-identity",
    "Audience": "lyra-api",
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "PlaylistRag": {
    "PrefetchCount": 3,
    "ConcurrentMessageLimit": 3,
    "RetryCount": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Rag": {
    "Provider": "OpenCode",
    "Model": "text-embedding-3-small",
    "Dimensions": 1536,
    "OpenCodePlan": "Go",
    "MaxInputCharacters": 8000,
    "RequestTimeoutSeconds": 60
  },
  "Playlists": {
    "DefaultLimit": 20,
    "MaxLimit": 50,
    "MaxPromptCharacters": 2000,
    "MaxSemanticQueryCharacters": 1000,
    "MaxTitleCharacters": 120,
    "MaxDescriptionCharacters": 600,
    "MaxMoodCount": 5,
    "MaxThemeCount": 8,
    "MaxFilterValueCharacters": 128,
    "MaxCandidatePool": 80,
    "CandidatePoolMultiplier": 4,
    "MaxCandidatesPerArtist": 2,
    "MaxReasonCharacters": 240
  },
  "Identity": {
    "GrpcAddress": "http://localhost:5004",
    "RequestTimeoutSeconds": 10
  },
  "InternalServices": {
    "ApiKey": ""
  },
  "AiProviders": {
    "RequestTimeout": "00:01:30",
    "MaxOutputTokens": 2048,
    "MaxModelLength": 200,
    "MaxApiKeyLength": 512
  }
}
