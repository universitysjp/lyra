{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://lyra-identity",
    "Audience": "lyra-api",
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-limiter",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-UserId" },
          { "RequestHeaderRemove": "userId" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-UserId" },
          { "RequestHeaderRemove": "userId" }
        ]
      },
      "playlists-route": {
        "ClusterId": "playlists-cluster",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/playlists/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-UserId" },
          { "RequestHeaderRemove": "userId" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "playlists-cluster": {
        "Destinations": {
          "playlists-service": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
