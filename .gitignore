bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
*.pem

# Secrets / local environment — never commit real credentials.
.env
.env.*
!.env.example

# Rider HTTP client environments (may contain secrets).
http-client.private.env.json

# IDE data sources can embed credentials in JDBC URLs.
.idea/**/dataSources.xml
.idea/**/dataSources.local.xml

# Local browser-audit artifacts
.playwright-cli/

# Test and coverage output
TestResults/
*.trx
coverage/
.vs/

# Vendored agent-skill packs, IDE state, and agent tool plans/state stay local — never commit them.
/skills/
/.idea/
/.junie/
