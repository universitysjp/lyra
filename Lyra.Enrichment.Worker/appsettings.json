{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Worker": {
    "PrefetchCount": 3,
    "ConcurrentMessageLimit": 3,
    "RetryCount": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Identity": {
    "GrpcAddress": "http://localhost:5004",
    "RequestTimeoutSeconds": 10
  },
  "InternalServices": {
    "ApiKey": ""
  },
  "Lrclib": {
    "BaseUrl": "https://lrclib.net",
    "RequestTimeoutSeconds": 15,
    "MinRequestIntervalMilliseconds": 300,
    "UserAgent": "Lyra.Enrichment.Worker/1.0"
  },
  "Enrichment": {
    "ResultCacheTtl": "30.00:00:00",
    "LockExpiry": "00:02:00",
    "MaxLyricsCharacters": 12000
  },
  "AiProviders": {
    "RequestTimeout": "00:01:30",
    "MaxOutputTokens": 2048,
    "MaxModelLength": 200,
    "MaxApiKeyLength": 512
  }
}
