@baseUrl = http://localhost:5001

### OIDC Discovery
GET {{baseUrl}}/.well-known/openid-configuration
Accept: application/json

### JWKS
GET {{baseUrl}}/.well-known/jwks.json
Accept: application/json

### Register
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password123!"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password123!"
}

### Get Current User (Me)
@accessToken = {{login.response.body.accessToken}}
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Refresh Token
@refreshToken = {{login.response.body.refreshToken}}
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Logout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Save AI Provider Connection (BYOK)
# Provider is one of: OpenAI, Gemini, OpenCode, Anthropic.
# openCodePlan is only allowed for OpenCode (PayAsYouGo, Go).
PUT {{baseUrl}}/api/auth/ai-connection
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "provider": "Gemini",
  "model": "gemini-2.5-flash",
  "apiKey": "PASTE_PROVIDER_API_KEY_HERE",
  "openCodePlan": null
}

### Get AI Provider Connection Metadata (never returns the key)
GET {{baseUrl}}/api/auth/ai-connection
Authorization: Bearer {{accessToken}}
Accept: application/json

### Delete AI Provider Connection
DELETE {{baseUrl}}/api/auth/ai-connection
Authorization: Bearer {{accessToken}}
