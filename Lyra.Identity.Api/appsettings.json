{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://lyra-identity",
    "Audience": "lyra-api",
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RequireHttpsMetadata": false
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 8
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:15:00",
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "AppStrings": {
    "Errors": {
      "IdentityDbMissing": "IdentityDb connection string is missing.",
      "EmailPasswordRequired": "Email and password are required.",
      "InvalidCredentials": "Invalid email or password.",
      "UserLockedOut": "The user account is temporarily locked out due to multiple failed login attempts.",
      "InvalidOrExpiredToken": "The provided token is invalid, expired, or has been revoked.",
      "UserNotFound": "User not found.",
      "RsaKeyNotConfigured": "RSA signing key is not configured in production. Set 'Jwt:SigningKey'.",
      "UnhandledError": "An error occurred while processing your request.",
      "ValidationFailed": "One or more validation errors occurred.",
      "InvalidInputCode": "InvalidInput"
    },
    "Titles": {
      "Unauthorized": "Unauthorized",
      "AccountLocked": "Account Locked",
      "NotFound": "Not Found",
      "InternalServerError": "An error occurred while processing your request."
    },
    "Logs": {
      "ValidationFailure": "Validation failure on {Path}",
      "AuthenticationFailed": "Authentication failed on {Path}: {Message}",
      "TokenValidationFailed": "Token validation failed on {Path}: {Message}",
      "LockedOutAttempt": "Locked out user attempt on {Path}: {Message}",
      "ResourceNotFound": "Resource not found on {Path}: {Message}",
      "UnhandledException": "Unhandled exception processing request on {Path}",
      "LoadingDevKey": "Loading development RSA signing key from {Path}",
      "GeneratingDevKey": "Generating new development RSA signing key and persisting to {Path}",
      "TokenReuseDetected": "Refresh token reuse detected for user {UserId}. Revoking token family."
    },
    "Endpoints": {
      "MeLocation": "/api/auth/me"
    }
  }
}
