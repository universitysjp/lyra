# Template for the repository-root `.env` file (gitignored).
# Copy this file to `.env` and fill in real values before running anything:
#   cp .env.example .env
# Docker Compose reads `.env` automatically; .NET services (Identity, Catalog)
# load it at startup via DotNetEnv and map `Section__Key` variables onto their
# configuration.

# ── Docker Compose infrastructure ────────────────────────────────────────────
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=change-me
RABBITMQ_DEFAULT_PASS=change-me

# ── .NET service configuration (double-underscore = config section separator) ─
ConnectionStrings__IdentityDb=Host=localhost;Port=5432;Database=identity_db;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
ConnectionStrings__CatalogDb=Host=localhost;Port=5432;Database=catalog_db;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
ConnectionStrings__Redis=localhost:6379

RabbitMq__Host=localhost
RabbitMq__Username=${RABBITMQ_DEFAULT_USER}
RabbitMq__Password=${RABBITMQ_DEFAULT_PASS}

# ── AI provider keys (used by Enrichment Worker / PlaylistRag once wired up) ──
# Ai__Provider=gemini
# Ai__ApiKey=

# ── Optional: existing PostgreSQL server for integration tests ────────────────
# (when Docker/Testcontainers is unavailable)
# LYRA_TEST_POSTGRES=Host=localhost;Port=5432;Database=postgres;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
